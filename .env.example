# NetBird OIDC client in Keycloak
NB_OIDC_CLIENT_ID=netbird
NB_OIDC_CLIENT_SECRET=change-me-oidc

# Database passwords
NB_DB_PASSWORD=change-me-nbdb
MP_DB_PASSWORD=change-me-mpdb
